<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only. No cleartext, no user-installed CAs, no pinning exceptions. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
